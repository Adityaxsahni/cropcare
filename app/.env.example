# Copy to .env and fill in. EXPO_PUBLIC_ values are built into the app; never put secrets here.

# Backend base URL, e.g. https://api.your-domain.example . Leave empty to build an app that never uploads.
EXPO_PUBLIC_API_URL=

# Privacy policy page on the project website, e.g. https://your-domain.example/privacy.html
EXPO_PUBLIC_PRIVACY_URL=
