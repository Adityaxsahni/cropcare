{
  "name": "cropcare",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.25",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-vision-camera": "^5.2.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check:launch": "python ../scripts/check_launch.py"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  }
}
