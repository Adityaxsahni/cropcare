# Copy to .env for local runs. Never commit the real file.

# SQLite for local development; a Postgres URL in production.
DATABASE_URL=sqlite:///./cropcare.db

# Long random string. Needed only to publish reviewed advice with PUT /advice.
ADMIN_TOKEN=

# Proxies in front of the server whose X-Forwarded-For entry can be trusted (Render: 1). 0 ignores the header.
TRUSTED_PROXY_HOPS=0
